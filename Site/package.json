{
  "name": "urlcheck-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-scripts.mjs && node scripts/generate-docs.mjs",
    "dev": "npm run generate && vite",
    "build": "npm run generate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "upgrade": "node -e \"require('fs').rmSync('package-lock.json',{force:true})\" && npx npm-check-updates -u"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.71.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.37.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7",
    "vite": "^8.3.7"
  }
}
