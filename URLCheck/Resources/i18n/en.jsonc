  "error.no_filter_rules": "No $removeparam rules found — this does not look like an AdGuard-style list.",
  "settings.startup": "Startup",
  "settings.startup_description": "How URLCheck starts together with the system.",
  "settings.start_with_session": "Start with the system",
  "settings.start_with_session_description": "Registers URLCheck to start with your session, so it is already running when a link is clicked. Unchecking removes it again.",
  "settings.hide_on_launch": "Start hidden",
  "settings.hide_on_launch_description": "Launch without showing the management window; the inspection popup still appears. Needs the tray icon, and never applies when a link started the app.",
  "settings.auto_strip_tracking": "Strip tracking parameters on open",
  "settings.auto_strip_tracking_description": "Remove known tracking parameters (utm_*, fbclid, ...) from a URL as soon as the popup opens. When off, use the Tracking button in the popup instead.",
  "settings.show_url_button": "Floating button for copied links",
  "settings.show_url_button_description": "Watch the clipboard and float a small button next to the pointer whenever the copied text is an http(s) URL, so it can be inspected without switching applications.",
  "settings.script_network": "Script network access",
  "settings.script_network_description": "Let Lua scripts make HTTP requests. A script must also set scriptNetwork = true. Once this is on, an installed script can send the URLs it sees to any server; leave it off unless you trust every script.",
  "settings.forwarding": "Device forwarding",
  "settings.forwarding_description": "Send a URL from the popup to another URLCheck device on your local network, where it opens in its own inspection popup. Devices find each other automatically and pair with a one-time code; nothing ever leaves your network.",
  "settings.forwarding_enabled": "Enable device forwarding",
  "settings.forwarding_enabled_description": "Accept pairing requests and forwarded URLs, and answer device searches on the local network. Off by default.",
