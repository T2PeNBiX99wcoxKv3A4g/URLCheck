  "settings.startWithSession": "Start with the system",
  "settings.startWithSessionDescription": "Registers URLCheck to start with your session, so it is already running when a link is clicked. Unchecking removes it again.",
  "settings.hideOnLaunch": "Start hidden",
  "settings.hideOnLaunchDescription": "Launch without showing the management window; the inspection popup still appears. Needs the tray icon, and never applies when a link started the app.",
