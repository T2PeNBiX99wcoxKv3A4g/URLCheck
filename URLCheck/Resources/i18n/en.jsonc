  "settings.filter_format_title": "Supported rule formats",
  "settings.filter_format_body": "AdGuard / uBlock Origin lists that use $removeparam rules, ClearURLs' JSON catalog, and Firefox's query-stripping records. Host scoping (||host^ and domain=), regular expressions (/pattern/), per-provider URL patterns and exceptions (domain=~host, denyallow=, ClearURLs exceptions, Firefox allow lists) are supported; everything else in a list is ignored.",
  "filters.catalog.adguard_url_tracking": "AdGuard's list of URL tracking parameters: UTM tags, advertising click ids, e-mail tracking and more.",
  "filters.catalog.ubo_url_tracking": "uBlock Origin's copy of the AdGuard URL tracking rules, with extra community fixes.",
  "filters.catalog.clear_urls": "ClearURLs' provider-aware catalog: per-site parameter names, regular expressions and URL exceptions.",
  "filters.catalog.firefox": "The small, conservative parameter set Firefox strips in Enhanced Tracking Protection.",
