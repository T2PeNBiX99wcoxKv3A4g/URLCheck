  "settings.filterFormatTitle": "Supported rule formats",
  "settings.filterFormatBody": "AdGuard / uBlock Origin lists that use $removeparam rules, ClearURLs' JSON catalog, and Firefox's query-stripping records. Host scoping (||host^ and domain=), regular expressions (/pattern/), per-provider URL patterns and exceptions (domain=~host, denyallow=, ClearURLs exceptions, Firefox allow lists) are supported; everything else in a list is ignored.",
  "filters.catalog.adguardUrlTracking": "AdGuard's list of URL tracking parameters: UTM tags, advertising click ids, e-mail tracking and more.",
  "filters.catalog.uboUrlTracking": "uBlock Origin's copy of the AdGuard URL tracking rules, with extra community fixes.",
  "filters.catalog.clearUrls": "ClearURLs' provider-aware catalog: per-site parameter names, regular expressions and URL exceptions.",
