    "react-simple-code-editor": "^0.14.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^26",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "npm-check-updates": "^23.1.1",
    "sass": "^1.106.1",
    "typescript": "^7",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0"
  },
  "allowScripts": {
