<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Platforms>AnyCPU</Platforms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Required by the [LibraryImport] source generator -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- WinRT interop goes through built-in COM; trimming disables it unless asked. -->
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <!-- Generate embedded file manifest when using the Photino.NET StaticFileServer -->
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <RootNamespace>URLCheck</RootNamespace>
        <Version>1.16.2</Version>
        <!-- Explorer/taskbar icon; also embedded (Resources\**) so the tray can load it at runtime. -->
        <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
        <!-- Suppress trim warnings from third-party libraries -->
        <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Jint" Version="4.17.0" />
        <PackageReference Include="LuaCSharp" Version="0.5.8"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0"/>
        <!-- PhotinoNETUtils is built against Microsoft.Extensions 11; keep this in step with it. -->
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="11.0.0" />
        <PackageReference Include="Photino.NET" Version="4.0.16" />
        <PackageReference Include="securifybv.ShellLink" Version="0.1.0" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Expressions" Version="5.0.0"/>
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Tomlyn" Version="2.11.1" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And ('$(RuntimeIdentifier)' == '' Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win')))">
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And ('$(RuntimeIdentifier)' == '' Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win')))">
        <!-- The Windows share sheet lives in the WinRT projections. They are not part of the
             target framework, so reference the SDK assemblies directly and ship them with the app. -->
        <PackageDownload Include="Microsoft.Windows.SDK.NET.Ref" Version="[10.0.28000.87]" />
        <Reference Include="Microsoft.Windows.SDK.NET">
            <HintPath>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\10.0.28000.87\lib\net9.0\Microsoft.Windows.SDK.NET.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="WinRT.Runtime">
            <HintPath>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\10.0.28000.87\lib\net9.0\WinRT.Runtime.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Analyzer Include="Libs\PhotinoNETUtils.Generators.dll" />
        <AdditionalFiles Include="Resources\i18n\*.jsonc" />
    </ItemGroup>

    <PropertyGroup>
        <!-- One executable per platform under Libs/CodeGen/<rid>; the host RID picks the right one.
             Framework-dependent single-file: a Windows machine can cross-publish the Linux build. -->
        <SettingsCodeGenPath>$(MSBuildProjectDirectory)\Libs\CodeGen\$(NETCoreSdkRuntimeIdentifier)\PhotinoNETUtils.CodeGen</SettingsCodeGenPath>
        <SettingsCodeGenPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(SettingsCodeGenPath).exe</SettingsCodeGenPath>
        <SettingsTypeScriptPath>$(MSBuildProjectDirectory)\UserInterface\src\api\settings.generated.ts</SettingsTypeScriptPath>
        <SettingsSchemaPath>$(MSBuildProjectDirectory)\UserInterface\src\api\settings.schema.json</SettingsSchemaPath>
        <LocalizationKeysPath>$(MSBuildProjectDirectory)\UserInterface\src\api\i18n.generated.ts</LocalizationKeysPath>
        <TranslationFile>$(MSBuildProjectDirectory)\Resources\i18n\en.jsonc</TranslationFile>
    </PropertyGroup>

    <!-- The translation keys are not a build product; the file is read directly. -->
    <Target Name="GenerateLocalizationKeys"
            BeforeTargets="BeforeBuild"
            Condition="Exists('$(SettingsCodeGenPath)')"
            Inputs="$(TranslationFile);$(SettingsCodeGenPath)"
            Outputs="$(LocalizationKeysPath)">
        <Exec Command="&quot;$(SettingsCodeGenPath)&quot; --i18n &quot;$(TranslationFile)&quot; --i18n-out &quot;$(LocalizationKeysPath)&quot;"/>
    </Target>

    <!-- The settings come from the compiled model: the compiler has already resolved #if, partial
         files, const references and nameof, so the interface cannot disagree with the app. -->
    <Target Name="GenerateSettingsTypes"
            AfterTargets="CoreCompile"
            Condition="Exists('$(SettingsCodeGenPath)')"
            Inputs="@(IntermediateAssembly);$(SettingsCodeGenPath)"
            Outputs="$(SettingsTypeScriptPath);$(SettingsSchemaPath)">
        <Exec Command="&quot;$(SettingsCodeGenPath)&quot; --assembly &quot;@(IntermediateAssembly)&quot; --out &quot;$(SettingsTypeScriptPath)&quot; --schema &quot;$(SettingsSchemaPath)&quot;"/>
    </Target>

    <ItemGroup>
        <Reference Include="PhotinoNETUtils">
            <HintPath>Libs\PhotinoNETUtils.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**" />
    </ItemGroup>

</Project>
