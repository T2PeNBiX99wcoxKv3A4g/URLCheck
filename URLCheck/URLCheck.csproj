<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Platforms>AnyCPU</Platforms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Required by the [LibraryImport] source generator -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Generate embedded file manifest when using the Photino.NET StaticFileServer -->
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <RootNamespace>URLCheck</RootNamespace>
        <Version>0.7.0</Version>
        <!-- Explorer/taskbar icon; also embedded (Resources\**) so the tray can load it at runtime. -->
        <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
        <PackageReference Include="Photino.NET" Version="4.0.16" />
        <PackageReference Include="Photino.NET.Server" Version="4.0.12" />
        <PackageReference Include="securifybv.ShellLink" Version="0.1.0" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\**" />
    </ItemGroup>

</Project>
